# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# VLY Integration key for AI services (server-side only, never expose to client)
VLY_INTEGRATION_KEY=sk_your_integration_key_here

# Email OTP API key for sending verification emails
VLY_EMAIL_API_KEY=fb_your_email_api_key_here

# Optional: Application name displayed in email OTP requests
VLY_APP_NAME=Wareflow Control Tower

# Auth issuer for federated JWT tokens
VLY_CONVEX_AUTH_ISSUER=https://freebuff.com
